---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Needs from '../components/Needs.astro';
import Challenges from '../components/Challenges.astro';
import PillarDiagram from '../components/PillarDiagram.astro';
import SectorTabs from '../components/SectorTabs.astro';
import Scenarios from '../components/Scenarios.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { SITE } from '../data/site';
import { FAQ } from '../data/faq';
import { EQUIPO } from '../data/equipo';

const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.nombre,
  alternateName: 'CNV',
  url: SITE.url,
  logo: `${SITE.url}/logo.png`,
  image: `${SITE.url}/og-image.png`,
  slogan: SITE.lema,
  description: SITE.descripcion,
  email: SITE.email,
  areaServed: { '@type': 'Country', name: 'Chile' },
  address: { '@type': 'PostalAddress', addressLocality: 'Santiago', addressCountry: 'CL' },
  sameAs: [SITE.linkedin],
  founder: EQUIPO.map((p) => ({
    '@type': 'Person',
    name: p.nombre,
    jobTitle: p.cargo,
    url: `${SITE.url}/nosotros/${p.slug}/`,
    sameAs: p.linkedin,
  })),
};
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};
---
<Base jsonLd={[org, faq]}>
  <Hero />
  <Marquee />
  <Needs />
  <BeforeAfter />
  <Challenges />
  <PillarDiagram />
  <SectorTabs />
  <Scenarios />
  <Team />
  <Faq />
  <FinalCta />
</Base>
