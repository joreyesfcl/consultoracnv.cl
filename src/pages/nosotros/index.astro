---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Team from '../../components/Team.astro';
import CtaBand from '../../components/CtaBand.astro';
import { ENFOQUE, DIFERENCIADORES } from '../../data/nosotros';
---
<Base title="Nosotros" description="CNV fue fundada por economistas e ingenieros que trabajaron dentro del Sistema Nacional de Inversiones y del Sistema de Monitoreo y Evaluación.">
  <PageHero
    eyebrow="Nosotros"
    title="Nacimos desde adentro del sistema."
    lead="Conocemos los sistemas de evaluación de programas e inversiones públicas porque trabajamos en las instituciones que los administran."
    crumbs={[{ label: 'Nosotros' }]}
  />

  <section class="section" aria-labelledby="origen">
    <div class="container origin">
      <div class="text reveal">
        <p class="eyebrow">Origen</p>
        <h2 id="origen">Conocemos las reglas porque contribuimos a aplicarlas.</h2>
        <p>
          CNV fue fundada por economistas e ingenieros con experiencia directa en el Sistema Nacional de Inversiones y en el
          Sistema de Monitoreo y Evaluación de Programas Públicos.
        </p>
        <p>
          Ponemos ese conocimiento al servicio de instituciones públicas, empresas y organizaciones que participan en estos
          procesos, y también de quienes, sin formar parte del sistema, necesitan entenderlo o aplicar su rigor en sus propias
          decisiones.
        </p>
        <p class="def">
          <strong>Inteligencia aplicada a la intervención.</strong> Llamamos intervención a todo programa, proyecto o inversión
          con que una organización busca cambiar algo en un territorio.
        </p>
      </div>
      <ul class="enfoque stagger" role="list">
        {ENFOQUE.map((e) => (
          <li>
            <p class="lbl">{e.etiqueta}</p>
            <h3>{e.titulo}</h3>
            <p>{e.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section alt" aria-labelledby="dif">
    <div class="container">
      <SectionHead id="dif" eyebrow="Qué nos diferencia" title="Una combinación poco frecuente." lead="Varias consultoras ofrecen formulación, diseño de programas o asesoría en sostenibilidad. Lo que nos distingue es la suma de estos atributos." />
      <ol class="difs" role="list">
        {DIFERENCIADORES.map((d, i) => (
          <li class="dif reveal">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{d.titulo}</h3>
              <p>{d.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="equipo-t">
    <div class="container" style="padding-top: var(--section)">
      <SectionHead id="equipo-t" eyebrow="Equipo" title="Socios fundadores." />
    </div>
  </section>
  <Team head={false} />

  <CtaBand />
</Base>

<style>
  .origin { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .text { display: grid; gap: 1.1rem; }
  .text p { color: var(--text-muted); font-size: 1.05rem; max-width: 62ch; }
  .def { padding: 1.2rem 1.4rem; border-left: 3px solid var(--accent); background: var(--surface-2); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .def strong { display: block; color: var(--text); font-family: var(--font-display); font-style: italic; font-size: 1.1rem; margin-bottom: 0.2rem; }
  .enfoque { list-style: none; padding: 0; display: grid; gap: 0.8rem; }
  .enfoque li { display: grid; gap: 0.35rem; padding: 1.4rem; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); }
  .enfoque p:not(.lbl) { color: var(--text-muted); font-size: 0.94rem; }
  .lbl { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .alt { background: var(--surface-2); }
  .difs { list-style: none; padding: 0; display: grid; max-width: 900px; }
  .dif { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1.2rem; padding: 1.8rem 0; border-bottom: 1px solid var(--border); }
  .dif:last-child { border-bottom: 0; }
  .n { font-family: var(--font-display); font-size: 2.4rem; font-weight: 600; line-height: 1; color: var(--accent); }
  .dif h3 { margin-bottom: 0.4rem; }
  .dif p { color: var(--text-muted); }
  @media (max-width: 900px) { .origin { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .dif { grid-template-columns: 3rem 1fr; } .n { font-size: 1.8rem; } }
</style>
