---
// Redirección de las antiguas páginas de pilar (/servicios/<pilar>/) a su área equivalente.
// Si el enlace traía el ancla de un servicio (#s-03-8), se lleva al servicio nuevo en su área.
import { AREAS, PILAR_A_AREA, ancla } from '../../data/servicios';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return Object.keys(PILAR_A_AREA).map((slug) => ({ params: { slug } }));
}
const destino = `/soluciones/${PILAR_A_AREA[Astro.params.slug!]}/`;
// Ancla antigua (s-03-8) → dirección nueva del servicio
const mapa: Record<string, string> = {};
for (const a of AREAS) for (const s of a.servicios) mapa[ancla(s.antes)] = `/soluciones/${a.slug}/#${ancla(s.codigo)}`;
---
<!doctype html>
<html lang="es-CL">
<head>
<meta charset="utf-8">
<title>Página trasladada · {SITE.nombre}</title>
<meta name="robots" content="noindex">
<link rel="canonical" href={`${SITE.url}${destino}`}>
<script is:inline define:vars={{ mapa, destino }}>
  var h = location.hash.slice(1);
  location.replace(mapa[h] || destino);
</script>
<meta http-equiv="refresh" content={`0; url=${destino}`}>
</head>
<body>
<p>Esta página se trasladó a <a href={destino}>{SITE.url.replace('https://', '')}{destino}</a>.</p>
</body>
</html>
