---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Scenarios from '../../components/Scenarios.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { SECTORES } from '../../data/sectores';
import { PILARES } from '../../data/servicios';

export function getStaticPaths() {
  return SECTORES.map((s) => ({ params: { slug: s.slug } }));
}
const s = SECTORES.find((x) => x.slug === Astro.params.slug)!;
const servicios = s.servicios.map((c) => {
  const p = PILARES.find((p) => p.servicios.some((x) => x.codigo === c))!;
  return { p, sv: p.servicios.find((x) => x.codigo === c)! };
});
// Titular de cada sector (texto + acento en cursiva)
const TITULOS: Record<string, [string, string]> = {
  publico: ['Instituciones que invierten', 'con recursos públicos.'],
  empresas: ['Empresas con', 'operación territorial.'],
  'tercer-sector': ['Fundaciones, corporaciones', 'y ONG.'],
};
const [titulo, acento] = TITULOS[s.slug] ?? [s.nombre, ''];
const perfilesTitulo = s.perfiles.length === 2 ? 'Dos perfiles' : s.perfiles.length === 3 ? 'Tres perfiles' : 'Cuatro perfiles';
---
<Base title={s.nombre} description={s.bajada} tone="dark">
  <PageHero tone="dark" eyebrow={s.nombre} title={titulo} accent={acento} lead={s.bajada} crumbs={[{ label: 'Sectores' }, { label: s.nombre }]}>
    <nav class="switch" aria-label="Sectores">
      {SECTORES.map((o) => (
        <a href={`/sectores/${o.slug}/`} class:list={['chip', { on: o.slug === s.slug }]} aria-current={o.slug === s.slug ? 'page' : undefined}>{o.nombre}</a>
      ))}
    </nav>
  </PageHero>

  <section class="section" aria-labelledby="perfiles">
    <div class="container">
      <SectionHead id="perfiles" eyebrow="Con quién trabajamos" title={perfilesTitulo} accent="que acompañamos." />
      <ul class="perfiles stagger" role="list">
        {s.perfiles.map((p, i) => (
          <li class="spotlight">
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section alt" aria-labelledby="frecuentes">
    <div class="container two">
      <div>
        <SectionHead id="frecuentes" eyebrow="Servicios más pedidos" title="Por dónde suele" accent="empezar el trabajo." lead="Una selección de los 27 servicios. Todos están disponibles para este sector." />
        <a href="/servicios/" class="link">Ver los 27 servicios <Icon name="arrow-right" /></a>
      </div>
      <ol class="svcs" role="list">
        {servicios.map(({ p, sv }) => (
          <li>
            <a href={`/servicios/${p.slug}/#s-${sv.codigo.replace('.', '-')}`}>
              <span class="mono">{sv.codigo}</span>
              <span class="t"><strong>{sv.nombre}</strong><span>{sv.descripcion}</span></span>
              <Icon name="arrow-right" />
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Scenarios tipos={s.escenarios} title={s.escenarios.length > 1 ? 'Situaciones tipo' : 'Una situación tipo,'} accent={s.escenarios.length > 1 ? 'en este sector.' : 'antes y después.'} />

  <CtaBand />
</Base>

<style>
  .switch { display: flex; flex-wrap: wrap; gap: 8px; }
  .switch .chip { color: var(--soft-blue); border-color: rgba(185, 206, 232, 0.4); }
  .switch .chip:hover { color: var(--snow); border-color: var(--cyan); }
  .switch .chip.on { background: var(--cyan); border-color: var(--cyan); color: var(--navy); }
  .perfiles { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .perfiles li { display: grid; gap: 10px; align-content: start; padding: 24px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); }
  .perfiles .mono { font-size: 0.78rem; color: var(--accent); }
  .perfiles h3 { font-size: 1.4rem; }
  .perfiles p { color: var(--text-muted); font-size: 0.95rem; }
  .two { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 4vw, 4rem); align-items: start; }
  .svcs { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .svcs a { display: grid; grid-template-columns: 64px minmax(0, 1fr) 24px; gap: 12px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--line); color: var(--text); text-decoration: none; }
  .svcs a:hover strong { color: var(--accent); }
  .svcs .mono { font-size: 0.85rem; color: var(--accent); }
  .svcs .t { display: grid; gap: 0.2rem; }
  .svcs .t span { font-size: 0.9rem; color: var(--text-muted); }
  .svcs :global(svg) { color: var(--accent); width: 18px; }
  @media (max-width: 900px) { .two { grid-template-columns: 1fr; } }
</style>
