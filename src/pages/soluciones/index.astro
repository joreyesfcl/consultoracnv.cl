---
// Soluciones (lienzo, artboard 27): las cinco áreas, el catálogo agrupado por área con filtro y
// buscador, y la rueda como vista complementaria. Lógica del filtro en src/scripts/ui.ts ([data-filter]).
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import AreaCards from '../../components/AreaCards.astro';
import PillarDiagram from '../../components/PillarDiagram.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { AREAS, TOTAL_SERVICIOS, ancla } from '../../data/servicios';
import { SITE } from '../../data/site';

const COLORS = ['var(--p01)', 'var(--p02)', 'var(--p03)', 'var(--p04)', 'var(--p05)'];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Soluciones de Consultora CNV',
  itemListElement: AREAS.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE.url}/soluciones/${a.slug}/`,
    name: a.nombre,
  })),
};
---
<Base title="Soluciones" description="Cinco áreas de solución: diagnóstico y evidencia; diseño de programas y proyectos; evaluación y seguimiento; carteras, inversión y financiamiento; estrategia y capacidades." jsonLd={schema}>
  <PageHero
    eyebrow="Soluciones"
    title="Cinco áreas para pasar"
    accent="del problema a la decisión."
    lead="Cada solución se contrata por separado o encadenada con otras. Si no sabe por dónde empezar, cuéntenos el problema y le proponemos la ruta."
    crumbs={[{ label: 'Soluciones' }]}
  />

  <AreaCards head={false} id="areas" />

  <section class="section alt" aria-labelledby="catalogo">
    <div class="container">
      <SectionHead id="catalogo" eyebrow="Catálogo" title="Todas las soluciones," accent="por área." />
      <div class="filters reveal" data-filter>
        <div class="chips" role="group" aria-label="Filtrar por área">
          <button type="button" aria-pressed="true" data-f="todos">Todas</button>
          {AREAS.map((a) => <button type="button" aria-pressed="false" data-f={a.numero}>{a.numero} · {a.nombre}</button>)}
        </div>
        <label class="search">
          <Icon name="search" size={18} />
          <span class="sr-only">Buscar una solución</span>
          <input type="search" id="buscar-solucion" placeholder="Buscar: evaluación, fondos, indicadores…" data-q />
        </label>
      </div>
      <p class="count muted" aria-live="polite" data-count-label>{TOTAL_SERVICIOS} soluciones</p>
      <div class="groups">
        {AREAS.map((a, i) => (
          <div class="group" data-group style={`--c:${COLORS[i]}`}>
            <h3><span class="sw" aria-hidden="true"></span><span class="mono">{a.numero}</span> <a href={`/soluciones/${a.slug}/`}>{a.nombre}</a></h3>
            <ul role="list">
              {a.servicios.map((s) => (
                <li data-item data-area={a.numero} data-search={`${s.codigo} ${s.nombre} ${s.corto} ${s.descripcion}`}>
                  <details>
                    <summary><span class="mono code">{s.codigo}</span><span class="name">{s.corto}</span><span class="plus" aria-hidden="true"></span></summary>
                    <div class="more">
                      <p>{s.descripcion}</p>
                      <a href={`/soluciones/${a.slug}/#${ancla(s.codigo)}`} class="link">Ver en el área {a.numero}<span class="sr-only">: {s.corto}</span> <Icon name="arrow-right" /></a>
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="empty muted" data-empty hidden>No encontramos soluciones con esa búsqueda. Pruebe con otra palabra o escríbanos.</p>
    </div>
  </section>

  <PillarDiagram
    id="mapa"
    eyebrow="Vista complementaria"
    title="Todo lo que hacemos,"
    accent="en una rueda."
    lead="El anillo interior son las cinco áreas; cada segmento exterior es una solución. Al pasar el cursor muestra su ficha."
  />

  <CtaBand />
</Base>

<style>
  .filters { display: grid; gap: 1rem; margin-bottom: 1rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips button {
    min-height: 44px;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .chips button:hover { border-color: var(--accent); }
  .chips button[aria-pressed='true'] { background: var(--heading); border-color: var(--heading); color: var(--bg); }
  .search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 520px;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid var(--field-border);
    background: var(--surface);
    color: var(--text-muted);
  }
  .search:focus-within { border-color: var(--accent); outline: 2px solid var(--accent); outline-offset: 2px; }
  .search input { flex: 1; min-width: 0; min-height: 44px; padding: 0.8rem 0; border: 0; background: none; outline: none; color: var(--text); }
  .count { font-size: 0.9rem; margin-bottom: 1.2rem; }
  .groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 3rem; align-items: start; }
  .group[hidden] { display: none; }
  .group h3 { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem; font-size: 1.4rem; font-weight: 500; }
  .group h3 a { color: var(--heading); text-decoration: none; }
  .group h3 a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  .group h3 .mono { font-size: 0.85rem; color: var(--accent); }
  .sw { width: 14px; height: 14px; border-radius: 4px; background: var(--c); flex-shrink: 0; }
  .group ul { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .group li { border-bottom: 1px solid var(--line); }
  .group li[hidden] { display: none; }
  summary { display: grid; grid-template-columns: 52px minmax(0, 1fr) 20px; gap: 10px; align-items: center; min-height: 52px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .code { font-size: 0.8rem; color: var(--text-muted); }
  .name { font-weight: 500; }
  .plus { position: relative; width: 14px; height: 14px; }
  .plus::before, .plus::after { content: ''; position: absolute; left: 0; top: 6px; width: 14px; height: 2px; background: var(--accent); transition: transform 0.2s var(--ease); }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0deg); }
  .more { display: grid; gap: 0.3rem; padding: 0 0 1rem 62px; }
  .more p { color: var(--text-muted); font-size: 0.95rem; }
  @media (max-width: 860px) { .groups { grid-template-columns: 1fr; } .more { padding-left: 0; } }
</style>
