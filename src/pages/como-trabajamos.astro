---
// Cómo trabajamos (lienzo, artboard 30): tres formatos y el método, qué cambia en la práctica,
// y el trabajo interdisciplinario y de transferencia.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Metodo from '../components/Metodo.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base title="Cómo trabajamos" description="Tres formas de trabajar (diagnóstico puntual, desarrollo integral y acompañamiento a equipos) y un mismo método: del problema a la decisión.">
  <PageHero
    eyebrow="Cómo trabajamos"
    title="Tres formas de trabajar,"
    accent="un mismo método."
    lead="El alcance se define después de entender el problema. Usted elige cuánto hacemos nosotros y cuánto su equipo."
    crumbs={[{ label: 'Cómo trabajamos' }]}
  />

  <Metodo ejemplo={false} detalle={true} enlace={false} />

  <BeforeAfter />

  <section class="section" aria-label="Interdisciplina y transferencia">
    <div class="container duo">
      <div class="box">
        <h2>Trabajo interdisciplinario</h2>
        <p>En cada encargo se integran el análisis económico, los datos, el conocimiento institucional y la perspectiva territorial.</p>
      </div>
      <div class="box">
        <h2>Transferencia a su equipo</h2>
        <p>Cuando corresponde, entregamos las herramientas y dejamos a su equipo en condiciones de usarlas por su cuenta.</p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .box { display: grid; gap: 0.8rem; align-content: start; padding: clamp(1.5rem, 3vw, 2rem); border-radius: 22px; background: var(--surface-2); }
  .box h2 { font-size: var(--step-2); font-weight: 400; }
  .box p { color: var(--text-muted); }
  @media (max-width: 760px) { .duo { grid-template-columns: 1fr; } }
</style>
