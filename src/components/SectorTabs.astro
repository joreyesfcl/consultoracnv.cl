---
// Sectores en pestañas (mesa 15): bajada, perfiles y servicios más pedidos por sector.
import Icon from './Icon.astro';
import { SECTORES } from '../data/sectores';
import { ESCENARIOS } from '../data/escenarios';
import { PILARES } from '../data/servicios';

const todos = PILARES.flatMap((p) => p.servicios.map((s) => ({ ...s, slug: p.slug })));
const svc = (c: string) => todos.find((s) => s.codigo === c)!;
const escenario = (tipo: string) => ESCENARIOS.find((e) => e.tipo === tipo);
---
<section class="section sectors on-ice" id="sectores" aria-labelledby="sec-title">
  <div class="container" data-tabs>
    <div class="top">
      <header class="section-head reveal">
        <p class="eyebrow">Para quién trabajamos</p>
        <h2 id="sec-title">Un mismo catálogo, <em>tres formas de usarlo.</em></h2>
      </header>
      <div class="tabs reveal" role="tablist" aria-label="Sectores">
        {SECTORES.map((s, i) => (
          <button type="button" role="tab" id={`tab-${s.slug}`} aria-controls={`panel-${s.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            {s.nombre}
          </button>
        ))}
      </div>
    </div>
    {SECTORES.map((s, i) => {
      const e = escenario(s.escenarios[0]);
      return (
        <div class="panel" role="tabpanel" id={`panel-${s.slug}`} aria-labelledby={`tab-${s.slug}`} hidden={i !== 0}>
          <div class="main">
            <p class="bajada">{s.bajada}</p>
            <ul class="perfiles" role="list">
              {s.perfiles.map((p) => (
                <li><h3>{p.titulo}</h3><p>{p.texto}</p></li>
              ))}
            </ul>
          </div>
          <aside class="side on-dark">
            <p class="eyebrow">Servicios más pedidos</p>
            <ul role="list" class="svcs">
              {s.servicios.map((c) => {
                const x = svc(c);
                return <li><a href={`/servicios/${x.slug}/#s-${c.replace('.', '-')}`}><span class="mono">{c}</span>{x.nombre}</a></li>;
              })}
            </ul>
            {e && <p class="esc">Situación tipo: {e.titulo}</p>}
            <a href={`/sectores/${s.slug}/`} class="btn">Ver la página del sector <Icon name="arrow-right" /></a>
          </aside>
        </div>
      );
    })}
  </div>
</section>

<style>
  .top { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .top .section-head { margin: 0; }
  .tabs { display: flex; gap: 6px; padding: 6px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); }
  [role='tab'] { min-height: 48px; padding: 0 22px; border: 0; border-radius: 999px; background: transparent; font-size: 0.95rem; font-weight: 600; color: var(--text); }
  [role='tab'][aria-selected='true'] { background: var(--navy); color: var(--snow); }
  :global(:root[data-theme='dark']) [role='tab'][aria-selected='true'] { background: var(--cyan); color: var(--navy); }
  .panel { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; row-gap: 1.5rem; }
  .panel:not([hidden]) { animation: swap-in 0.45s var(--ease) both; }
  .main { grid-column: span 7; display: grid; gap: 1.4rem; align-content: start; }
  .bajada { font-family: var(--font-display); font-weight: 300; font-size: var(--step-2); line-height: 1.3; color: var(--heading); }
  .perfiles { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .perfiles li { display: grid; gap: 6px; align-content: start; padding: 18px 20px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .perfiles h3 { font-family: var(--font-body); font-size: 1rem; font-weight: 600; }
  .perfiles p { font-size: 0.9rem; color: var(--text-muted); }
  .side { grid-column: 9 / span 4; display: grid; gap: 14px; align-content: start; padding: 26px; border-radius: 22px; }
  .svcs { list-style: none; padding: 0; }
  .svcs a { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); color: var(--snow); text-decoration: none; font-size: 0.9rem; line-height: 1.35; }
  .svcs a:hover { color: var(--cyan); }
  .svcs .mono { font-size: 0.75rem; color: var(--cyan); }
  .esc { font-size: 0.85rem; color: var(--soft-blue); }
  @media (max-width: 960px) {
    .main, .side { grid-column: 1 / -1; }
    .perfiles { grid-template-columns: 1fr; }
    .tabs { width: 100%; }
    [role='tab'] { flex: 1; padding: 0 10px; font-size: 0.85rem; }
  }
</style>
