---
import { Picture } from 'astro:assets';
import fondo from '../assets/main.png';
import Icon from './Icon.astro';

// Nodos aproximados sobre el trazado de Chile en main.png (coordenadas de la imagen 1254×820)
const nodos = [
  [1122, 96], [1138, 160], [1128, 222], [1112, 288], [1098, 352],
  [1084, 418], [1070, 482], [1056, 540], [1046, 596], [1072, 640], [1112, 668],
];
// Titular dividido en palabras para la entrada escalonada
const titular = ['Mejores', 'decisiones'];
const acento = ['para', 'el', 'territorio.'];
const lineas = [
  'M760 660 C 880 610, 980 640, 1056 540',
  'M820 720 C 930 700, 1010 690, 1072 640',
  'M1254 380 C 1190 390, 1130 400, 1098 352',
  'M1254 560 C 1180 560, 1110 580, 1056 540',
];
---
<section class="hero on-dark" data-hero aria-labelledby="hero-title">
  <Picture
    src={fondo}
    alt=""
    formats={['avif', 'webp']}
    widths={[640, 960, 1254]}
    sizes="(max-width: 760px) 300vw, 100vw"
    loading="eager"
    fetchpriority="high"
    class="hero-bg"
    data-parallax
  />
  <svg class="hero-net" viewBox="0 0 1254 820" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
    <defs>
      <radialGradient id="glow">
        <stop offset="0%" stop-color="#3FD7FF" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#3FD7FF" stop-opacity="0" />
      </radialGradient>
    </defs>
    {lineas.map((d, i) => <path d={d} class="net-line" style={`--d:${i * 1.3}s`} />)}
    {nodos.map(([x, y], i) => (
      <g class="node" style={`--n:${i}; --d:${(i * 0.37) % 3}s`}>
        <circle cx={x} cy={y} r="14" fill="url(#glow)" class="net-halo" />
        <circle cx={x} cy={y} r="2.6" class="net-dot" />
      </g>
    ))}
  </svg>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-content">
    <p class="eyebrow">Inteligencia aplicada a la intervención</p>
    <h1 id="hero-title" aria-label="Mejores decisiones para el territorio.">
      <span class="words" aria-hidden="true">
        {titular.map((w, i) => <span class="w" style={`--w:${i}`}>{w}</span>)}
        <em>{acento.map((w, i) => <span class="w" style={`--w:${i + titular.length}`}>{w}</span>)}</em>
      </span>
    </h1>
    <p class="lead">
      Acompañamos a instituciones públicas, empresas y fundaciones a decidir dónde actuar, con qué programas y con qué recursos, desde el diagnóstico hasta los resultados.
    </p>
    <div class="hero-ctas">
      <a href="/contacto/" class="btn magnetic">Conversemos <Icon name="arrow-right" /></a>
      <a href="/servicios/" class="btn btn-ghost">Ver servicios</a>
    </div>
  </div>

</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    isolation: isolate;
    overflow: hidden;
  }
  .hero-bg, .hero-bg :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    z-index: -3;
  }
  .hero-net {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
  }
  .net-dot { fill: #EAF6FF; }
  :global(.motion) .node { animation: ignite 0.9s var(--ease) both; animation-delay: calc(0.5s + var(--n) * 0.14s); }
  @keyframes ignite {
    0% { opacity: 0; }
    40% { opacity: 1; filter: drop-shadow(0 0 10px #3FD7FF); }
    100% { opacity: 1; filter: none; }
  }
  .net-halo { opacity: 0.25; transform-box: fill-box; transform-origin: center; }
  .net-line {
    fill: none;
    stroke: #3FD7FF;
    stroke-width: 1.2;
    stroke-opacity: 0.55;
    stroke-dasharray: 6 220;
    stroke-linecap: round;
  }
  @media (prefers-reduced-motion: no-preference) {
    .net-halo { animation: pulse 3.2s var(--ease) infinite var(--d); }
    .net-line { animation: flow 7s linear infinite var(--d); }
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.15; transform: scale(0.7); }
    50% { opacity: 0.7; transform: scale(1.5); }
  }
  @keyframes flow { to { stroke-dashoffset: -452; } }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(7, 28, 56, 0.92) 0%, rgba(7, 28, 56, 0.7) 38%, rgba(7, 28, 56, 0) 68%),
      linear-gradient(0deg, rgba(7, 28, 56, 0.85) 0%, rgba(7, 28, 56, 0) 30%);
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(520px circle at var(--gx, 80%) var(--gy, 40%), rgba(63, 215, 255, 0.1), transparent 60%);
    transition: background 0.2s linear;
  }
  .hero-bg, .hero-bg :global(img) { will-change: transform; }

  .hero-content {
    align-self: center;
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    padding-block: calc(var(--header-h) + 3rem) 3rem;
  }
  .hero-content > * { max-width: 640px; }
  h1 { font-size: clamp(2.6rem, 1.6rem + 4.4vw, 5rem); line-height: 1.04; letter-spacing: -0.025em; }
  h1 em { font-style: italic; font-weight: 500; color: var(--cyan); }
  .words { display: block; }
  .w { display: inline-block; margin-right: 0.24em; }
  h1 em { display: inline-block; }
  :global(.motion) .w {
    animation: word 0.9s var(--ease) both;
    animation-delay: calc(0.15s + var(--w) * 0.11s);
  }
  @keyframes word {
    from { opacity: 0; transform: translateY(0.45em) rotate(2deg); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }
  .lead { color: rgba(234, 246, 255, 0.82); }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.5rem; }

  :global(.motion) .hero-content > :not(h1) { animation: rise 0.9s var(--ease) both; }
  :global(.motion) .hero-content > .eyebrow { animation-delay: 0s; }
  :global(.motion) .hero-content > .lead { animation-delay: 0.55s; }
  :global(.motion) .hero-content > .hero-ctas { animation-delay: 0.7s; }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }


  @media (max-width: 760px) {
    .hero-shade {
      background: linear-gradient(180deg, rgba(7, 28, 56, 0.55) 0%, rgba(7, 28, 56, 0.82) 45%, rgba(7, 28, 56, 0.95) 100%);
    }
  }
</style>
