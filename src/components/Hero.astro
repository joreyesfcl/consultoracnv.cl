---
// Portada (mesa 01 del lienzo "Estratos"): la imagen de marca ocupa toda la portada, ajustada
// al alto para que Chile se vea completo, con el texto encima a la izquierda. Sobre la imagen,
// una retícula geográfica calibrada, Santiago referenciado y un punto que sigue al cursor
// (lógica en src/scripts/motion.ts).
import { Picture } from 'astro:assets';
import fondo from '../assets/main.png';
import Icon from './Icon.astro';
import { SITE } from '../data/site';

// Índice lateral: secciones del Inicio
const indice = [
  ['contribuir', 'En qué contribuimos'],
  ['que-cambia', 'Qué cambia'],
  ['desafios', 'Desafíos'],
  ['modelo', 'Modelo de servicios'],
  ['sectores', 'Sectores'],
  ['equipo', 'Equipo'],
];
// Escala de la retícula en coordenadas de la imagen (1254×820): latitud → y, longitud → x.
// Calibrada sobre la silueta de Chile de main.png; Santiago (33°27′S · 70°40′O) queda en (1094.4, 337.1).
const lat = (l: number) => 86.6 + (l - 17.5) * 15.73;
const lon = (o: number) => 1094.4 + (70.67 - o) * 18.22;
const paralelos = [20, 30, 40, 50];
const meridianos = [76, 72, 68];
const flujos = [
  'M760 660 C 880 610, 1005 510, 1094.4 337.1',
  'M820 720 C 950 674, 1051 510, 1094.4 337.1',
  'M1254 380 C 1190 390, 1133 364, 1094.4 337.1',
  'M1254 560 C 1187 547, 1119 437, 1094.4 337.1',
  'M600 301 C 786 292, 950 351, 1094.4 337.1',
];
---
<section class="hero on-dark" aria-labelledby="hero-title" data-tracker>
  <div class="map" aria-hidden="true">
    <Picture src={fondo} alt="" formats={['avif', 'webp']} widths={[768, 1254]} sizes="(max-width: 900px) 900px, 1400px" loading="eager" fetchpriority="high" class="img" />
    <svg viewBox="0 0 1254 820" class="overlay">
      <defs>
        <radialGradient id="hGlow"><stop offset="0%" stop-color="#3FD7FF" stop-opacity="0.9" /><stop offset="100%" stop-color="#3FD7FF" stop-opacity="0" /></radialGradient>
      </defs>
      <g class="grid">
        {paralelos.map((l) => <line x1="700" y1={lat(l)} x2="1254" y2={lat(l)} />)}
        {meridianos.map((o) => <line x1={lon(o)} y1="0" x2={lon(o)} y2="820" />)}
      </g>
      <g class="labels">
        {paralelos.map((l) => <text x="712" y={lat(l) - 6}>{l}°S</text>)}
        {meridianos.map((o) => <text x={lon(o) + 5} y="806">{o}°O</text>)}
      </g>
      <g class="flows">
        {flujos.map((d, i) => <path d={d} style={`--d:${-i * 1.4}s`} />)}
      </g>
      <g class="santiago">
        <g class="scale">
          <line x1="760" y1="337.1" x2="1080" y2="337.1" class="guide" />
          <line x1="712" y1="337.1" x2="750" y2="337.1" class="tick" />
          <text x="712" y="329" class="lat">33°27′S</text>
        </g>
        <circle cx="1094.4" cy="337.1" r="15" fill="url(#hGlow)" opacity="0.55" />
        <circle cx="1094.4" cy="337.1" r="11" class="ring" />
        <circle cx="1094.4" cy="337.1" r="6.5" class="ring-static" />
        <circle cx="1094.4" cy="337.1" r="2.4" class="dot" />
        <text x="1081" y="315" text-anchor="end" class="name">SANTIAGO</text>
        <text x="1081" y="328" text-anchor="end" class="coords">33°27′S · 70°40′O</text>
      </g>
      <g class="tracker" data-tracker-dot>
        <circle r="16" fill="url(#hGlow)" opacity="0.7" />
        <circle r="8" class="t-ring" />
        <circle r="3.2" class="t-dot" />
        <text x="14" y="3" data-tracker-label></text>
      </g>
    </svg>
  </div>
  <div class="veil" aria-hidden="true"></div>

  <div class="hero-text">
    <ol class="index" aria-label="En esta página">
      {indice.map(([id, label], i) => (
        <li><a href={`#${id}`} class:list={{ on: i === 0 }}><span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="sr-only">{label}</span><span class="tip" aria-hidden="true">{label}</span></a></li>
      ))}
    </ol>
    <div class="copy">
      <p class="eyebrow rise">{SITE.lema}</p>
      <h1 id="hero-title" class="rise">Mejores decisiones <em>para el territorio.</em></h1>
      <div class="bottom rise">
        <p class="lead">Acompañamos a instituciones públicas, empresas y fundaciones a decidir dónde actuar, con qué programas y con qué recursos.</p>
        <div class="ctas">
          <a href="/contacto/" class="btn magnetic">Conversemos <Icon name="arrow-right" /></a>
          <a href="/servicios/" class="btn btn-ghost">Ver servicios</a>
        </div>
      </div>
    </div>
    <div class="foot mono">
      <span>Sector público · Empresas · Tercer sector</span>
      <a href="#contribuir" class="scroll">Desplácese <span aria-hidden="true"></span></a>
    </div>
  </div>
</section>

<style>
  /* La portada sube bajo la cabecera transparente; el fondo continúa el borde izquierdo de la imagen */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    min-height: 100svh;
    max-height: 1100px;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    background: linear-gradient(180deg, #010c35 0%, #01072d 100%);
  }
  .map { position: absolute; z-index: -2; top: 0; right: 0; height: 100%; aspect-ratio: 1254 / 820; }
  .img, .img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .overlay { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .veil { position: absolute; z-index: -1; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(1, 8, 40, 0.6) 0%, rgba(1, 8, 40, 0.25) 45%, rgba(1, 8, 40, 0) 62%); }
  .hero-text {
    grid-column: span 7;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    column-gap: 2rem;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 4vw, 3.5rem) 2rem var(--gutter);
  }
  .index { align-self: center; list-style: none; padding: 0; display: grid; gap: 0.9rem; border-left: 1px solid var(--line); font-family: var(--font-mono); font-size: 0.7rem; }
  .index a { position: relative; display: block; padding-left: 0.8rem; margin-left: -1px; color: var(--text-muted); text-decoration: none; border-left: 2px solid transparent; }
  .index a.on, .index a:hover { color: var(--accent); border-left-color: var(--accent); }
  .tip { position: absolute; left: 3rem; top: 50%; transform: translate(-6px, -50%); white-space: nowrap; padding: 0.2rem 0.5rem; border-radius: 6px; background: var(--heading); color: var(--bg); opacity: 0; pointer-events: none; transition: opacity 0.2s, transform 0.2s var(--ease); }
  .index a:hover .tip, .index a:focus-visible .tip { opacity: 1; transform: translate(0, -50%); }
  .copy { align-self: center; display: grid; gap: clamp(1.2rem, 2.5vw, 1.8rem); }
  h1 { font-size: clamp(3rem, 1.2rem + 5.4vw, 7rem); line-height: 0.92; letter-spacing: -0.045em; }
  .bottom { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; align-items: end; }
  .lead { font-size: var(--step-1); color: #D6E4F5; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .foot { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  .scroll { display: inline-flex; align-items: center; gap: 0.6rem; color: inherit; text-decoration: none; }
  .scroll span { display: inline-block; width: 1px; height: 22px; background: var(--accent); }

  .grid line { stroke: #EAF6FF; stroke-opacity: 0.14; }
  .labels text, .santiago text, .tracker text { font-family: var(--font-mono); letter-spacing: 1px; }
  .labels text { font-size: 10px; fill: var(--soft-blue); }
  .flows path { fill: none; stroke: #3FD7FF; stroke-width: 1.2; stroke-opacity: 0.6; stroke-linecap: round; stroke-dasharray: 6 220; }
  .guide { stroke: #3FD7FF; stroke-opacity: 0.55; stroke-dasharray: 2 5; }
  .tick { stroke: #3FD7FF; stroke-width: 1.5; }
  .lat { font-size: 10px; fill: #3FD7FF; }
  .ring, .ring-static { fill: none; stroke: #3FD7FF; }
  .ring { stroke-width: 1.5; transform-box: fill-box; transform-origin: center; }
  .dot { fill: var(--snow); }
  .name { font-size: 11px; font-weight: 500; fill: var(--snow); letter-spacing: 1.5px; }
  .coords { font-size: 9px; fill: var(--soft-blue); }
  .tracker { opacity: 0; transition: opacity 0.35s var(--ease); pointer-events: none; }
  .tracker.on { opacity: 1; }
  .t-ring { fill: none; stroke: #3FD7FF; stroke-opacity: 0.6; }
  .t-dot { fill: #3FD7FF; }
  .tracker text { font-size: 9px; fill: var(--snow); }
  @media (prefers-reduced-motion: no-preference) {
    .flows path { animation: flow 7s linear infinite var(--d); }
    .ring { animation: ring 2.4s ease-out infinite; }
  }
  @keyframes flow { to { stroke-dashoffset: -452; } }
  @keyframes ring { 0% { opacity: 0.8; transform: scale(0.6); } 100% { opacity: 0; transform: scale(2.2); } }

  :global(.motion) .rise { animation: rise 0.9s var(--ease) both; }
  :global(.motion) h1.rise { animation-delay: 0.1s; }
  :global(.motion) .bottom.rise { animation-delay: 0.3s; }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }

  /* Con menos ancho, la escala de latitud quedaría bajo el texto */
  @media (max-width: 1180px) {
    .labels, .scale { display: none; }
  }
  @media (max-width: 1080px) {
    .bottom { grid-template-columns: 1fr; gap: 1.4rem; }
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; max-height: none; }
    .hero-text { grid-column: 1; grid-template-columns: 1fr; grid-template-rows: auto; align-content: start; padding: 1.5rem var(--gutter) 2.5rem; }
    .index { display: none; }
    .foot { display: none; }
    .map { top: auto; bottom: 0; height: min(66svh, 600px); -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 24%); mask-image: linear-gradient(180deg, transparent 0%, #000 24%); }
    .veil { background: linear-gradient(180deg, rgba(1, 8, 40, 0.7) 0%, rgba(1, 8, 40, 0.45) 45%, rgba(1, 8, 40, 0) 70%); }
    .lead { max-width: 30ch; }
  }
</style>
