---
import Icon from './Icon.astro';
---
<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Activar tema oscuro" title="Cambiar tema">
  <Icon name="moon" size={19} class="i-moon" />
  <Icon name="sun" size={19} class="i-sun" />
</button>

<style>
  .theme-toggle {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(185, 206, 232, 0.2);
    border-radius: 999px;
    background: transparent;
    color: var(--snow);
    transition: background-color 0.2s, border-color 0.2s, transform 0.3s var(--ease);
  }
  .theme-toggle:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(63, 215, 255, 0.5); }
  .theme-toggle:active { transform: rotate(-20deg); }
  .theme-toggle :global(.i-sun) { display: none; }
  :global([data-theme='dark']) .theme-toggle :global(.i-sun) { display: block; }
  :global([data-theme='dark']) .theme-toggle :global(.i-moon) { display: none; }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const root = document.documentElement;
  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    btn.setAttribute('aria-pressed', String(dark));
    btn.setAttribute('aria-label', dark ? 'Activar tema claro' : 'Activar tema oscuro');
  };
  sync();
  btn.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('cnv-theme', next); } catch {}
    sync();
  });
</script>
