---
// Banda de cierre breve para páginas internas.
import Icon from './Icon.astro';
interface Props { title?: string; accent?: string; text?: string }
const {
  title = '¿Conversamos',
  accent = 'sobre su caso?',
  text = 'Cuéntenos el desafío en sus propios términos. La traducción a servicios la hacemos nosotros.',
} = Astro.props;
---
<section class="band-wrap">
  <div class="container">
    <div class="band on-dark grat reveal">
      <div>
        <h2>{title} <em>{accent}</em></h2>
        <p class="muted">{text}</p>
      </div>
      <a href="/contacto/" class="btn magnetic">Conversemos <Icon name="arrow-right" /></a>
    </div>
  </div>
</section>

<style>
  .band-wrap { padding-bottom: var(--section); }
  .band { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; padding: clamp(2rem, 4vw, 3rem); border-radius: 28px; overflow: hidden; }
  .band > div { display: grid; gap: 0.6rem; max-width: 680px; }
  h2 { font-size: var(--step-3); }
</style>
