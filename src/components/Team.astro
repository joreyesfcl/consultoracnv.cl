---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { EQUIPO } from '../data/equipo';

interface Props { head?: boolean }
const { head = true } = Astro.props;
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/socios/*.{jpeg,jpg,png}', { eager: true });
const foto = (slug: string) => Object.entries(fotos).find(([k]) => k.includes(`/${slug}.`))![1].default;
---
<section class="section team" aria-labelledby={head ? 'team-title' : undefined} aria-label={head ? undefined : 'Equipo'}>
  <div class="container">
    {head && <div class="intro">
      <SectionHead
        id="team-title"
        eyebrow="Quiénes somos"
        title="Nacimos desde adentro del sistema."
        lead="CNV fue fundada por economistas e ingenieros que trabajaron dentro del Sistema Nacional de Inversiones y del Sistema de Monitoreo y Evaluación. Conocemos las reglas porque contribuimos a aplicarlas."
      />
    </div>}
    <ul class="grid stagger" role="list">
      {EQUIPO.map((p) => (
        <li class="person tilt spotlight">
          <a class="photo" href={`/nosotros/${p.slug}/`} tabindex="-1" aria-hidden="true">
            <Image
              src={foto(p.slug)}
              alt=""
              widths={[360, 540, 720]}
              sizes="(max-width: 700px) 90vw, 380px"
              style={`object-position:${p.fotoPosicion}`}
            />
            <span class="exp">{p.experiencia}</span>
          </a>
          <div class="info">
            <p class="cargo">{p.cargo}</p>
            <h3><a href={`/nosotros/${p.slug}/`}>{p.nombre}</a></h3>
            <p class="hito">{p.hito}</p>
            <ul class="tags" role="list">
              {p.especialidades.map((e) => <li>{e}</li>)}
            </ul>
            <div class="actions">
              <a class="link" href={`/nosotros/${p.slug}/`}>Ver perfil <Icon name="arrow-right" /></a>
              <a class="li" href={p.linkedin} target="_blank" rel="noopener" aria-label={`LinkedIn de ${p.nombre}`}><Icon name="linkedin" size={18} /></a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .person {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .photo { position: relative; display: block; aspect-ratio: 4 / 4.3; overflow: hidden; background: var(--navy); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease), filter 0.8s var(--ease); filter: saturate(0.9); }
  .person:hover .photo :global(img) { transform: scale(1.05); filter: saturate(1.05); }
  .photo::after { content: ''; position: absolute; inset: 55% 0 0 0; background: linear-gradient(to top, rgba(7, 28, 56, 0.75), transparent); }
  .exp {
    position: absolute;
    left: 1rem;
    bottom: 0.9rem;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--white);
  }
  .exp::after { content: ' de experiencia'; font-family: var(--font-body); font-size: 0.8rem; font-weight: 500; color: var(--soft-blue); }
  .info { display: grid; gap: 0.7rem; align-content: start; padding: 1.5rem; }
  .cargo { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  h3 { font-size: 1.35rem; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .hito { color: var(--text-muted); font-size: 0.94rem; }
  .tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .tags li { padding: 0.25rem 0.65rem; border-radius: 999px; border: 1px solid var(--border); font-size: 0.78rem; color: var(--text-muted); }
  .actions { display: flex; justify-content: space-between; align-items: center; margin-top: 0.4rem; padding-top: 1rem; border-top: 1px solid var(--border); }
  .li { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 10px; color: var(--text-muted); background: var(--surface-2); transition: background-color 0.2s, color 0.2s; }
  .li:hover { background: var(--accent); color: var(--accent-contrast); }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; max-width: 440px; } }
</style>
