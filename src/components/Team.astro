---
// Equipo en duotono (mesa 06): fotos en cobalto que recuperan su color al pasar el cursor.
// Cada socio se presenta con su hito de trayectoria (sin cifras de años).
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { EQUIPO } from '../data/equipo';

interface Props { head?: boolean }
const { head = true } = Astro.props;
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/socios/*.{jpeg,jpg,png}', { eager: true });
const foto = (slug: string) => Object.entries(fotos).find(([k]) => k.includes(`/${slug}.`))![1].default;
---
<section class="section team on-dark" id="equipo" aria-labelledby={head ? 'team-title' : undefined} aria-label={head ? undefined : 'Equipo'}>
  <div class="container">
    {head && (
      <div class="top">
        <header class="section-head reveal">
          <p class="eyebrow">Quiénes somos</p>
          <h2 id="team-title">Nacimos desde <em>adentro del sistema.</em></h2>
        </header>
        <a href="/nosotros/" class="link reveal">Conocer al equipo <Icon name="arrow-right" /></a>
      </div>
    )}
    <ul class="grid stagger" role="list">
      {EQUIPO.map((p) => (
        <li class="person">
          <a class="photo" href={`/nosotros/${p.slug}/`} tabindex="-1" aria-hidden="true">
            <Image src={foto(p.slug)} alt="" widths={[360, 540, 720]} sizes="(max-width: 700px) 90vw, 400px" style={`object-position:${p.fotoPosicion}`} />
          </a>
          <div class="info">
            <p class="mono cargo">{p.cargo}</p>
            <h3><a href={`/nosotros/${p.slug}/`}>{p.nombre}</a></h3>
            <p class="hito">{p.hito}</p>
            <ul class="tags" role="list">
              {p.especialidades.map((e) => <li>{e}</li>)}
            </ul>
            <div class="actions">
              <a class="link" href={`/nosotros/${p.slug}/`}>Ver perfil <Icon name="arrow-right" /></a>
              <a class="li" href={p.linkedin} target="_blank" rel="noopener" aria-label={`LinkedIn de ${p.nombre}`}><Icon name="linkedin" size={18} /></a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .top { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; }
  .top .section-head { margin-bottom: 2.5rem; }
  .top .link { margin-bottom: 2.8rem; }
  .grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .person {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 20px;
    overflow: hidden;
    background: var(--navy-2);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease), background-color 0.4s;
  }
  .photo { position: relative; display: block; aspect-ratio: 4 / 3.6; overflow: hidden; background: var(--cobalt); }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1) brightness(0.9);
    mix-blend-mode: luminosity;
    opacity: 0.85;
    transition: filter 0.6s var(--ease), opacity 0.6s var(--ease), transform 0.8s var(--ease), mix-blend-mode 0.6s;
  }
  .person:hover, .person:focus-within { transform: translateY(-8px); box-shadow: 0 0 0 2px var(--cyan), 0 30px 60px -20px rgba(63, 215, 255, 0.35); }
  .person:hover .photo :global(img), .person:focus-within .photo :global(img) { filter: none; mix-blend-mode: normal; opacity: 1; transform: scale(1.04); }
  .info { display: grid; gap: 0.7rem; align-content: start; padding: 1.4rem; }
  .cargo { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cyan); }
  h3 { font-size: 1.6rem; font-weight: 600; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .hito { color: var(--soft-blue); font-size: 0.94rem; }
  .tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .tags li { padding: 0.25rem 0.65rem; border-radius: 999px; border: 1px solid var(--line); font-size: 0.78rem; color: var(--soft-blue); }
  .actions { display: flex; justify-content: space-between; align-items: center; margin-top: 0.4rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .li { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 10px; color: var(--soft-blue); background: rgba(255, 255, 255, 0.06); transition: background-color 0.2s, color 0.2s; }
  .li:hover { background: var(--cyan); color: var(--navy); }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; max-width: 440px; } }
</style>
