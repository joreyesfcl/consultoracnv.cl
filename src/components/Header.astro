---
import { Image } from 'astro:assets';
import logo from '../assets/logo-cnv.png';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, CTA, SITE } from '../data/site';

const path = Astro.url.pathname;
// Activo si la página actual pertenece a la misma sección (primer segmento de la URL)
const isActive = (href: string) => path.startsWith('/' + href.split('/')[1] + '/');
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.nombre} — inicio`}>
      <Image src={logo} alt="" height={40} loading="eager" />
    </a>

    <nav class="nav-desktop" aria-label="Principal">
      <ul role="list">
        {NAV.map((item) => (
          <li class={item.children ? 'has-sub' : undefined}>
            {item.children ? (
              <>
                <button
                  class:list={['nav-link', { active: isActive(item.href) }]}
                  aria-expanded="false"
                  aria-controls="sub-sectores"
                  data-sub-toggle
                >
                  {item.label}
                  <Icon name="chevron-down" size={16} />
                </button>
                <div class="subnav" id="sub-sectores" data-sub>
                  <ul role="list">
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>
                          <strong>{c.label}</strong>
                          {c.desc && <span>{c.desc}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            ) : (
              <a
                href={item.href}
                class:list={['nav-link', { active: isActive(item.href) }]}
                aria-current={path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <a href={CTA.href} class="btn btn-cta magnetic">{CTA.label}</a>
      <button class="menu-btn" aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú" data-menu-toggle>
        <Icon name="menu" size={24} class="i-open" />
        <Icon name="x" size={24} class="i-close" />
      </button>
    </div>
  </div>

  <div class="nav-mobile" id="menu-movil" data-menu hidden>
    <nav class="container" aria-label="Principal (móvil)">
      <ul role="list">
        <li><a href="/">Inicio</a></li>
        {NAV.map((item) =>
          item.children ? (
            item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)
          ) : (
            <li><a href={item.href}>{item.label}</a></li>
          )
        )}
      </ul>
      <a href={CTA.href} class="btn">{CTA.label} <Icon name="arrow-right" /></a>
      <p class="nav-mobile-meta">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <span>{SITE.ciudad}</span>
      </p>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--header-h);
    color: var(--snow);
    background: rgba(7, 28, 56, 0);
    border-bottom: 1px solid transparent;
    transition: background-color 0.35s var(--ease), border-color 0.35s var(--ease), backdrop-filter 0.35s var(--ease), height 0.35s var(--ease);
  }
  .site-header.is-solid:not(.menu-open) { height: 62px; }
  .site-header.is-solid,
  .site-header.menu-open {
    background: rgba(7, 28, 56, 0.82);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom-color: rgba(185, 206, 232, 0.12);
  }
  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .brand { display: flex; align-items: center; flex-shrink: 0; }
  .brand img { height: 36px; width: auto; }

  .nav-desktop { margin-left: auto; }
  .nav-desktop > ul { display: flex; gap: 0.25rem; list-style: none; padding: 0; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.55rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: rgba(248, 251, 255, 0.82);
    font-size: 0.93rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s, background-color 0.2s;
  }
  .nav-link:hover, .nav-link[aria-expanded='true'] { color: var(--white); background: rgba(255, 255, 255, 0.08); }
  .nav-link.active { color: var(--cyan); }
  .nav-link :global(svg) { transition: transform 0.25s var(--ease); }
  .nav-link[aria-expanded='true'] :global(svg) { transform: rotate(180deg); }

  .has-sub { position: relative; }
  .subnav {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 50%;
    width: 300px;
    padding: 0.5rem;
    border-radius: var(--radius);
    background: rgba(11, 39, 72, 0.96);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(185, 206, 232, 0.14);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -6px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0.2s;
  }
  .subnav.open { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .subnav ul { list-style: none; padding: 0; }
  .subnav a {
    display: grid;
    gap: 0.1rem;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--snow);
  }
  .subnav a:hover, .subnav a[aria-current='page'] { background: rgba(63, 215, 255, 0.1); }
  .subnav strong { font-size: 0.93rem; font-weight: 600; }
  .subnav span { font-size: 0.8rem; color: var(--soft-blue); }

  .header-actions { display: flex; align-items: center; gap: 0.6rem; }
  .btn-cta {
    --btn-bg: var(--cobalt);
    --btn-fg: var(--white);
    min-height: 42px;
    padding: 0.55rem 1.2rem;
    font-size: 0.9rem;
  }

  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--snow);
  }
  .menu-btn :global(.i-close) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.i-open) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.i-close) { display: block; }

  .nav-mobile {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    overflow-y: auto;
    background: rgba(7, 28, 56, 0.97);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding-block: 1.5rem 3rem;
  }
  .nav-mobile nav { display: grid; gap: 2rem; }
  .nav-mobile ul { list-style: none; padding: 0; }
  .nav-mobile li a {
    display: block;
    padding: 0.9rem 0;
    border-bottom: 1px solid rgba(185, 206, 232, 0.12);
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--snow);
    text-decoration: none;
  }
  .nav-mobile .btn { --btn-bg: var(--cobalt); --btn-fg: var(--white); justify-self: start; }
  .nav-mobile-meta { display: grid; gap: 0.3rem; font-size: 0.9rem; color: var(--soft-blue); }
  .nav-mobile-meta a { color: var(--soft-blue); }

  @media (max-width: 960px) {
    .nav-desktop, .btn-cta { display: none; }
    .menu-btn { display: inline-flex; }
    .header-actions { margin-left: auto; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => header.classList.toggle('is-solid', window.scrollY > 24 || !document.querySelector('[data-hero]'));
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Submenú Sectores
  const subBtn = header.querySelector<HTMLButtonElement>('[data-sub-toggle]');
  const sub = header.querySelector<HTMLElement>('[data-sub]');
  if (subBtn && sub) {
    const li = subBtn.closest('li')!;
    const set = (open: boolean) => {
      subBtn.setAttribute('aria-expanded', String(open));
      sub.classList.toggle('open', open);
    };
    subBtn.addEventListener('click', () => set(subBtn.getAttribute('aria-expanded') !== 'true'));
    li.addEventListener('mouseenter', () => matchMedia('(hover: hover)').matches && set(true));
    li.addEventListener('mouseleave', () => matchMedia('(hover: hover)').matches && set(false));
    li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget as Node)) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); } });
  }

  // Menú móvil
  const menuBtn = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = header.querySelector<HTMLElement>('[data-menu]')!;
  const setMenu = (open: boolean) => {
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu.hidden = !open;
    header.classList.toggle('menu-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  menuBtn.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setMenu(false); menuBtn.focus(); } });
  matchMedia('(min-width: 961px)').addEventListener('change', (e) => e.matches && setMenu(false));
</script>
