---
import { Image } from 'astro:assets';
import logo from '../assets/logo-cnv.png';
import { SITE } from '../data/site';
import { SECTORES } from '../data/sectores';
import { AREAS } from '../data/servicios';

const year = new Date().getFullYear();
const corto = ['Diagnóstico y evidencia', 'Diseño de programas', 'Evaluación y seguimiento', 'Carteras y financiamiento', 'Estrategia y capacidades'];
---
<footer class="site-footer on-dark">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Image src={logo} alt={SITE.nombre} height={44} />
      <p class="eyebrow">{SITE.lema}</p>
    </div>

    <nav aria-label="Soluciones">
      <h2 class="footer-title">Soluciones</h2>
      <ul role="list">
        {AREAS.map((p, i) => <li><a href={`/soluciones/${p.slug}/`}><span class="mono">{p.numero}</span> {corto[i]}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Sitio">
      <h2 class="footer-title">Sitio</h2>
      <ul role="list">
        <li><a href="/como-trabajamos/">Cómo trabajamos</a></li>
        <li><a href="/sectores/">Sectores</a></li>
        {SECTORES.map((s) => <li><a href={`/sectores/${s.slug}/`}>{s.nombre}</a></li>)}
        <li><a href="/equipo/">Equipo</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="footer-title">Contacto</h2>
      <ul role="list">
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><span>{SITE.ciudad}</span></li>
        <li><a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn<span class="sr-only"> de Consultora CNV</span> <span aria-hidden="true">↗</span><span class="sr-only"> (se abre en una pestaña nueva)</span></a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {SITE.nombre}</p>
    <nav aria-label="Información legal y ayuda">
      <ul role="list" class="legal">
        <li><a href="/accesibilidad/">Accesibilidad</a></li>
        <li><a href="/mapa-del-sitio/">Mapa del sitio</a></li>
        <li><a href="/glosario/">Glosario</a></li>
        <li><a href="/privacidad/">Política de privacidad</a></li>
      </ul>
    </nav>
    <p class="mono coords">33°27′S · 70°40′O</p>
  </div>
</footer>

<style>
  .site-footer {
    --bg: var(--navy-deep);
    padding-block: clamp(3rem, 6vw, 4.5rem) 1.8rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    padding-bottom: 2.5rem;
  }
  .footer-brand { display: grid; gap: 1rem; align-content: start; justify-items: start; }
  .footer-brand :global(img) { height: 38px; width: auto; }
  .footer-brand .eyebrow { color: var(--soft-blue); }
  .footer-title { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cyan); margin-bottom: 1rem; }
  ul { list-style: none; padding: 0; display: grid; gap: 0; }
  li { font-size: 0.93rem; }
  /* Enlaces de 44 px de alto (WCAG 2.5.5) */
  a { display: inline-flex; align-items: center; gap: 0.4em; min-height: 44px; color: var(--snow); text-decoration: none; }
  a:hover { color: var(--cyan); text-decoration: underline; text-underline-offset: 4px; }
  .mono { font-size: 0.75rem; color: var(--soft-blue); }
  .legal { display: flex; flex-wrap: wrap; gap: 0 1.4rem; }
  .footer-bottom { align-items: center; }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.8rem 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(185, 206, 232, 0.16);
    font-size: 0.82rem;
    color: var(--soft-blue);
  }
  .footer-bottom a { color: var(--soft-blue); }
  .coords { letter-spacing: 0.08em; }
  @media (max-width: 860px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-brand { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
