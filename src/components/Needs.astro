---
// ¿Qué necesita resolver? (lienzo, artboard 26): al elegir una necesidad se muestra la ruta
// sugerida: el área, dos soluciones de ejemplo y un entregable posible. Es un orientador, no un
// diagnóstico ni una cotización. Lógica en src/scripts/ui.ts ([data-needs]); sin JS se ve la primera ruta.
import Icon from './Icon.astro';
import { NECESIDADES } from '../data/inicio';
import { area, servicio } from '../data/servicios';

const rutas = NECESIDADES.map((n) => ({ ...n, a: area(n.area), svcs: n.servicios.map((c) => servicio(c).s) }));
---
<section class="section needs on-ice" id="contribuir" aria-labelledby="needs-title" data-needs>
  <div class="container grid">
    <div class="left">
      <header class="section-head reveal">
        <p class="eyebrow">¿Qué necesita resolver?</p>
        <h2 id="needs-title">Cuéntenos el problema; <em>la ruta la armamos juntos.</em></h2>
      </header>
      <ul class="list" role="list">
        {rutas.map((n, i) => (
          <li>
            <button type="button" class="need" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`ruta-${i}`} data-need={i}>
              <span class="mono num">{String(i + 1).padStart(2, '0')}</span>
              <span class="texto">«{n.texto}»</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
    <div class="panel on-dark" aria-live="polite">
      {rutas.map((n, i) => (
        <div class="ruta" id={`ruta-${i}`} data-ruta={i} hidden={i !== 0}>
          <p class="eyebrow">Suele resolverse con</p>
          <h3><span class="mono">{n.a.numero}</span> {n.a.nombre}</h3>
          <ul role="list" class="svcs">
            {n.svcs.map((s) => <li><span class="mono">{s.codigo}</span><span>{s.corto}</span></li>)}
          </ul>
          <p class="deliv">Entregable posible: <strong>{n.entregable}</strong></p>
          <div class="actions">
            <a href={`/soluciones/${n.a.slug}/`} class="btn">Ver el área<span class="sr-only"> {n.a.nombre}</span> <Icon name="arrow-right" /></a>
            <a href="/contacto/" class="btn btn-ghost">Conversemos</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; row-gap: 2rem; }
  .left { grid-column: span 6; }
  .panel { grid-column: 8 / span 5; align-self: center; padding: clamp(1.5rem, 3vw, 2.2rem); border-radius: var(--radius-lg); background: var(--navy); }
  .list { list-style: none; padding: 0; display: grid; gap: 10px; }
  .need {
    width: 100%;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    min-height: 60px;
    padding: 10px 18px;
    border: 1px solid var(--field-border);
    border-radius: 14px;
    background: var(--surface);
    text-align: left;
    font-size: 1.08rem;
    line-height: 1.4;
    color: var(--text);
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s;
  }
  .need:hover { border-color: var(--accent); }
  .need[aria-pressed='true'] { background: var(--cobalt); border-color: var(--cobalt); color: var(--white); }
  :global(:root[data-theme='dark']) .need[aria-pressed='true'] { background: var(--cyan); border-color: var(--cyan); color: var(--navy); }
  .num { font-size: 0.75rem; color: var(--text-muted); }
  .need[aria-pressed='true'] .num { color: inherit; }
  .ruta { display: grid; gap: 1rem; }
  .ruta:not([hidden]) { animation: swap-in 0.4s var(--ease) both; }
  .ruta h3 { font-size: var(--step-2); font-weight: 400; line-height: 1.15; }
  .ruta h3 .mono { font-size: 0.9rem; color: var(--cyan); margin-right: 0.3rem; }
  .svcs { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .svcs li { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 10px; padding: 0.7rem 0; border-bottom: 1px solid var(--line); font-size: 0.97rem; }
  .svcs .mono { font-size: 0.78rem; color: var(--soft-blue); padding-top: 2px; }
  .deliv { color: var(--soft-blue); font-size: 0.95rem; }
  .deliv strong { color: var(--snow); font-weight: 600; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 960px) { .left, .panel { grid-column: 1 / -1; } }
</style>
