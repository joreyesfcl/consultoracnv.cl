---
import SectionHead from './SectionHead.astro';
import { FAQ } from '../data/faq';
---
<section class="section faq" id="preguntas" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <SectionHead id="faq-title" eyebrow="Preguntas frecuentes" title="Lo que suelen" accent="preguntarnos." />
    <div class="list stagger">
      {FAQ.map((f, i) => (
        <details open={i === 0}>
          <summary>
            <span>{f.pregunta}</span>
            <span class="pm" aria-hidden="true"></span>
          </summary>
          <p>{f.respuesta}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .list { display: grid; }
  details { border-bottom: 1px solid var(--line); interpolate-size: allow-keywords; }
  details:first-child { border-top: 1px solid var(--line); }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.3rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--heading);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--accent); }
  .pm { position: relative; width: 36px; height: 36px; flex-shrink: 0; border-radius: 999px; background: var(--surface-2); transition: background-color 0.3s, transform 0.35s var(--ease); }
  details[open] .pm { background: var(--navy); transform: rotate(45deg); }
  .pm::before, .pm::after {
    content: '';
    position: absolute;
    inset: 50% 11px auto 11px;
    height: 2px;
    margin-top: -1px;
    background: var(--heading);
  }
  .pm::after { transform: rotate(90deg); }
  details[open] .pm::before, details[open] .pm::after { background: var(--cyan); }
  details p { padding: 0 3.5rem 1.4rem 0; color: var(--text-muted); max-width: 66ch; }
  details::details-content { block-size: 0; overflow: hidden; transition: block-size 0.4s var(--ease), content-visibility 0.4s allow-discrete; }
  details[open]::details-content { block-size: auto; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
